                              }
                            ],
                            "body": {
                              "mode": "raw",
                              "raw": "{\n  \"status\": \"failed\",\n  \"occurred_at\": \"<dateTime>\",\n  \"reason\": \"other\",\n  \"notes\": \"<string>\"\n}",
