{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deliveroo Catalogue Orders API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deliveroo Update Order Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.developers.deliveroo.com/order/v1/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "gb:1234abcd-5678-90ef-ghij-klmnopqrstuv",
                "type": "path",
                "description": "The unique identifier of the Deliveroo order."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accept, reject, or confirm an order. The order must be in the PLACED status to be accepted or rejected. ASAP orders not accepted within 10 minutes (7 minutes for the Kuwait and UAE markets) are rejected automatically. Rate limited to 5 requests per minute per order."
        },
        {
          "info": {
            "name": "Deliveroo Create a New Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.developers.deliveroo.com/signature/v1/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new order for fulfillment by Deliveroo. It is recommended to create a quote first; the quote must be valid (created within the last 5 minutes) when the order is placed."
        }
      ]
    }
  ],
  "bundled": true
}