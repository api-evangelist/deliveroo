  "info": {
    "_postman_id": "f9bdc3e7-a880-444b-91e3-5f6565d9f418",
    "name": "Deliveroo Menu API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Part of the Deliveroo Partner Platform Suite. The Menu API lets integrators publish and retrieve restaurant menus, including items, modifiers, prices, POS identifiers, stock levels, and allergen data, so that the consumer-facing Deliveroo experience reflects merchant inventory and pricing. Menu uploads are processed asynchronously and the result is delivered via a menu webhook. Authentication uses an OAuth 2.0 client credentials bearer token.\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
