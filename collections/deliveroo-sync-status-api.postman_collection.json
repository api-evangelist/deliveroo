          "name": "Deliveroo Create Sync Status for an Order",
          "request": {
            "name": "Deliveroo Create Sync Status for an Order",
            "description": {
              "content": "Report whether the order was successfully sent to the site's in-store system. If Deliveroo does not receive a sync status within 3 minutes, or receives a failed status, it prompts site staff via the Deliveroo tablet to check their in-store system.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "order",
                "v1",
                "orders",
                ":order_id",
                "sync_status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "order_id",
                  "description": "(Required) The unique identifier of the Deliveroo order."
                }
              ]
            },
