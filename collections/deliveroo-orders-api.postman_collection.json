          "id": "55129435-ddbd-486a-811d-afe3120f9b4d",
          "name": "Deliveroo Update Order Status",
          "request": {
            "name": "Deliveroo Update Order Status",
            "description": {
              "content": "Accept, reject, or confirm an order. The order must be in the PLACED status to be accepted or rejected. ASAP orders not accepted within 10 minutes (7 minutes for the Kuwait and UAE markets) are rejected automatically. Rate limited to 5 requests per minute per order.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "order",
                "v1",
                "orders",
                ":order_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "order_id",
                  "description": "(Required) The unique identifier of the Deliveroo order."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
