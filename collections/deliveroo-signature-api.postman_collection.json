  "info": {
    "_postman_id": "cd710c8a-45e4-441b-bcf2-c001ba805f42",
    "name": "Deliveroo Signature API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Powers the Deliveroo Signature Suite, letting merchants request on-demand delivery by Deliveroo couriers for orders that originate in their own apps, websites, or channels. Integrators create a quote, then create an order for fulfillment, and can schedule deliveries via the delivery-as-a-service endpoint. Authentication uses an OAuth 2.0 client credentials bearer token.\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
