          "name": "Deliveroo Create Quote",
          "request": {
            "name": "Deliveroo Create Quote",
            "description": {
              "content": "Return an estimate and the delivery fee Deliveroo would charge for a given delivery. Creating a quote runs validation steps that surface errors which might otherwise cause order rejection. A quote is valid for 5 minutes, after which a new quote must be created before placing the order.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "signature",
                "v1",
                "quotes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
